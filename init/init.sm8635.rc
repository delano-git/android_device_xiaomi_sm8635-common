on post-fs-data
    # for primary panel
    chown system system /sys/class/mi_display/disp-DSI-0/wp_info
    chmod 0444 /sys/class/mi_display/disp-DSI-0/wp_info
    chown system system /sys/class/mi_display/disp-DSI-0/brightness_clone
    chmod 0664 /sys/class/mi_display/disp-DSI-0/brightness_clone
    chown system system /sys/class/mi_display/disp-DSI-0/max_brightness_clone
    chmod 0664 /sys/class/mi_display/disp-DSI-0/max_brightness_clone
    # for secondary panel
    chown system system /sys/class/mi_display/disp-DSI-1/wp_info
    chmod 0444 /sys/class/mi_display/disp-DSI-1/wp_info
    chown system system /sys/class/mi_display/disp-DSI-1/brightness_clone
    chmod 0664 /sys/class/mi_display/disp-DSI-1/brightness_clone
    chown system system /sys/class/mi_display/disp-DSI-1/max_brightness_clone
    chmod 0664 /sys/class/mi_display/disp-DSI-1/max_brightness_clone
    # display backlight sysfs node for ddsi and dp
    chown system system /sys/class/backlight/panel2-backlight/brightness
    chown system system /sys/class/backlight/panel2-backlight/max_brightness
    chown system system /sys/class/backlight/panel3-backlight/brightness
    chown system system /sys/class/backlight/panel3-backlight/max_brightness
    chown system system /sys/class/backlight/DP1-backlight/brightness
    chown system system /sys/class/backlight/DP1-backlight/max_brightness
    chown system system /sys/class/backlight/DP2-backlight/brightness
    chown system system /sys/class/backlight/DP2-backlight/max_brightness

    # GPU
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/min_freq
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/max_freq
    chmod 0660 /sys/class/kgsl/kgsl-3d0/devfreq/min_freq
    chmod 0660 /sys/class/kgsl/kgsl-3d0/devfreq/max_freq

    # CPU DMA Latency
    chown system system /dev/cpu_dma_latency
    chmod 0664 /dev/cpu_dma_latency

service vendor.pen-events /vendor/bin/init.pen.events.sh
    class late_start
    user root
    group root system input
    disabled
    oneshot

service vendor.xiaomi_pen /vendor/bin/xiaomi-pen
    class main
    user root
    group system
    oneshot

service vendor.focus-pen-filter /vendor/bin/xiaomi-focus-pen-filter
    class late_start
    user root
    group root system input uhid
    disabled

on property:sys.boot_completed=1
    start vendor.pen-events
    start vendor.focus-pen-filter

    # Enable PowerHAL hint processing
    setprop vendor.powerhal.init 1

on property:persist.pen.events.disabled=true
    start vendor.pen-events

on property:ro.boot.hwversion=*
    setprop ro.boot.hardware.revision ${ro.boot.hwc}_${ro.boot.hwlevel}_${ro.boot.hwversion}

# zram: lz4 instead of the kernel default lzo-rle. It decompresses several times
# faster, so swapped-out apps come back sooner, for a slightly worse ratio. Pixel
# devices use it. Must be set before init.kernel.post_boot.sh sizes the device
# after boot completes; that script only picks lz4 for low_ram (Go) targets.
on boot
    write /sys/block/zram0/comp_algorithm lz4

# User-defined throttling curve (replaces mi_thermald while enabled)
service vendor.ax_thermal_curve /vendor/bin/ax_thermal_curve.sh
    class main
    user root
    group root system
    disabled

on property:sys.boot_completed=1 && property:persist.sys.ax.thermal_curve=1
    stop mi_thermald
    start vendor.ax_thermal_curve

on property:persist.sys.ax.thermal_curve=0
    stop vendor.ax_thermal_curve
    exec - root system -- /vendor/bin/ax_thermal_curve.sh restore
    start mi_thermald
