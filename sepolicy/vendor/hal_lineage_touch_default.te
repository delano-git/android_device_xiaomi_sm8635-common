# High touch polling rate is toggled through the Xiaomi touchfeature HAL.
# Plain allow rules: this directory is parsed before the LineageOS one that
# declares hal_lineage_touch_default, so typeattribute-based macros can't be used.
allow hal_lineage_touch_default hal_touchfeature_xiaomi_service:service_manager find;
allow hal_lineage_touch_default hal_touchfeature_xiaomi_server:binder { call transfer };
allow hal_touchfeature_xiaomi_server hal_lineage_touch_default:binder transfer;
allow hal_touchfeature_xiaomi_server hal_lineage_touch_default:fd use;
