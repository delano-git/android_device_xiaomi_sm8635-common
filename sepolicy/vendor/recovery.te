# recovery_touch_thp runs Xiaomi's touch host processing daemon in recovery
allow recovery touchfeature_device:chr_file rw_file_perms;
allow recovery sysfs_touch_hostprocess:file rw_file_perms;
allow recovery proc_tp_file:file rw_file_perms;
allow recovery uhid_device:chr_file rw_file_perms;
allow recovery input_device:chr_file rw_file_perms;
allow recovery self:capability { sys_nice sys_time };
