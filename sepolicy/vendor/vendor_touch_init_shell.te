type vendor_touch_init_shell, domain;
type vendor_touch_init_shell_exec, exec_type, vendor_file_type, file_type;

# panel-info-sh and touch-kmsg-init-sh (odm touchfeature rc) are started with
# seclabel u:r:vendor_touch_init_shell:s0. Without this domain init can't
# setexeccon() and aborts the forked child, once per service, on every boot.
init_daemon_domain(vendor_touch_init_shell)

allow vendor_touch_init_shell vendor_shell_exec:file { rx_file_perms entrypoint execute_no_trans };
allow vendor_touch_init_shell vendor_toolbox_exec:file { rx_file_perms execute_no_trans };
allow vendor_touch_init_shell vendor_touch_init_shell_exec:file { r_file_perms entrypoint };

allow vendor_touch_init_shell sysfs:file r_file_perms;
allow vendor_touch_init_shell kmsg_device:chr_file r_file_perms;
allow vendor_touch_init_shell kernel:system syslog_read;

allow vendor_touch_init_shell vendor_data_touchreport_file:dir create_dir_perms;
allow vendor_touch_init_shell vendor_data_touchreport_file:file create_file_perms;

set_prop(vendor_touch_init_shell, vendor_panel_info_prop)
set_prop(vendor_touch_init_shell, vendor_touchfeature_prop)
