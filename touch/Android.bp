cc_binary {
    name: "vendor.lineage.touch-service.sm8635",
    init_rc: ["vendor.lineage.touch-service.sm8635.rc"],
    vintf_fragments: ["vendor.lineage.touch-service.sm8635.xml"],
    relative_install_path: "hw",
    vendor: true,
    srcs: [
        "HighTouchPollingRate.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "vendor.lineage.touch-V1-ndk",
        "vendor.xiaomi.hw.touchfeature-V1-ndk",
    ],
}
