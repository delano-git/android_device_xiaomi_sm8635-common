# Audio
audio.offload.min.duration.secs=30

# Bluetooth
bluetooth.device_id.vendor_id=0x001D

# Camera
persist.vendor.camera.gesture.emoji.support=1

# Dalvik
dalvik.vm.madvise.artfile.size=0
dalvik.vm.madvise.odexfile.size=0
dalvik.vm.madvise.vdexfile.size=0

# Display
persist.sys.disable_sdr_dimming=true

# Media
media.stagefright.audio.deep=false

# Perf
persist.sys.perf.scroll_opt=true
persist.sys.perf.scroll_opt.heavy_app=1

# RKPD
remote_provisioning.enable_rkpd=true
remote_provisioning.hostname=remoteprovisioning.googleapis.com

# Surfaceflinger
persist.sys.sf_charge_anim_supported=true
